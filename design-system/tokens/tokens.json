{
  "$description": "The Rogue Roadmap design system (rogue-road). Design Tokens Community Group format. tokens.css is generated from this file by scripts/build.mjs.",
  "color": {
    "$type": "color",
    "brand": {
      "navy": { "$value": "#0A1B35", "$description": "Brand navy: night, ink, the ground of the emblem." },
      "orange": { "$value": "#F7792C", "$description": "Brand orange: the sun. Fills and marks, never small text on cream." },
      "cream": { "$value": "#FCF3E1", "$description": "Brand cream: the rogue's cloak and the road. Paper by day." }
    },
    "navy": {
      "950": { "$value": "#050E1C" }, "900": { "$value": "#0A1B35" }, "850": { "$value": "#0E213F" },
      "800": { "$value": "#122746" }, "750": { "$value": "#152B4D" }, "700": { "$value": "#23395E" },
      "600": { "$value": "#3A5078" }, "500": { "$value": "#56627A" }, "400": { "$value": "#8A94A8" },
      "300": { "$value": "#B5BDCB" }, "200": { "$value": "#D9DEE7" }
    },
    "orange": {
      "100": { "$value": "#FFE6D3" }, "200": { "$value": "#FDBA8A" }, "300": { "$value": "#FB9B57" },
      "500": { "$value": "#F7792C" }, "600": { "$value": "#DB5F14" }, "700": { "$value": "#A8470F" },
      "800": { "$value": "#7A340C" }
    },
    "cream": {
      "50": { "$value": "#FFFCF6" }, "100": { "$value": "#FCF6EA" }, "200": { "$value": "#FCF3E1" },
      "300": { "$value": "#F4EAD6" }, "400": { "$value": "#EDE1C9" }, "500": { "$value": "#DCCFB6" },
      "600": { "$value": "#B9AA8D" }, "700": { "$value": "#AFAA9F" }
    },
    "role": {
      "danger": { "light": { "$value": "#C42B3A" }, "dark": { "$value": "#FF7A82" } },
      "success": { "light": { "$value": "#2F7D55" }, "dark": { "$value": "#5BD49A" } },
      "warning": { "light": { "$value": "#8F5A0F" }, "dark": { "$value": "#F5B544" } },
      "info": { "light": { "$value": "#5A47BF" }, "dark": { "$value": "#B3A6FF" } }
    }
  },
  "theme": {
    "$type": "color",
    "light": {
      "bg-page": { "$value": "{color.cream.300}" },
      "bg-surface": { "$value": "{color.cream.100}" },
      "bg-raised": { "$value": "{color.cream.50}" },
      "bg-sunken": { "$value": "{color.cream.400}" },
      "bg-inverse": { "$value": "{color.navy.900}" },
      "text-primary": { "$value": "{color.navy.900}" },
      "text-secondary": { "$value": "#2E3D57" },
      "text-muted": { "$value": "{color.navy.500}" },
      "text-inverse": { "$value": "{color.cream.200}" },
      "border": { "$value": "{color.cream.500}" },
      "border-strong": { "$value": "{color.cream.600}" },
      "accent": { "$value": "{color.orange.500}" },
      "accent-hover": { "$value": "{color.orange.600}" },
      "accent-text": { "$value": "{color.orange.700}" },
      "on-accent": { "$value": "{color.navy.900}" },
      "focus": { "$value": "{color.orange.600}" }
    },
    "dark": {
      "bg-page": { "$value": "{color.navy.900}" },
      "bg-surface": { "$value": "{color.navy.850}" },
      "bg-raised": { "$value": "{color.navy.750}" },
      "bg-sunken": { "$value": "{color.navy.950}" },
      "bg-inverse": { "$value": "{color.cream.200}" },
      "text-primary": { "$value": "{color.cream.200}" },
      "text-secondary": { "$value": "#D9D0BF" },
      "text-muted": { "$value": "{color.cream.700}" },
      "text-inverse": { "$value": "{color.navy.900}" },
      "border": { "$value": "{color.navy.700}" },
      "border-strong": { "$value": "{color.navy.600}" },
      "accent": { "$value": "{color.orange.500}" },
      "accent-hover": { "$value": "{color.orange.300}" },
      "accent-text": { "$value": "{color.orange.300}" },
      "on-accent": { "$value": "{color.navy.900}" },
      "focus": { "$value": "{color.orange.300}" }
    }
  },
  "day": {
    "$description": "The day cycle. A phase starts at `from` % of the journey (context, progress, time). `accent` tints UI; `sky` paints scenes.",
    "alba": { "from": { "$value": 0 }, "accent": { "$type": "color", "$value": "#E0708D" }, "sky": { "top": { "$value": "#2B2F5C" }, "mid": { "$value": "#8C6A9E" }, "horizon": { "$value": "#F6B38E" } } },
    "manana": { "from": { "$value": 15 }, "accent": { "$type": "color", "$value": "#F7792C" }, "sky": { "top": { "$value": "#4D6FA3" }, "mid": { "$value": "#C9A6B8" }, "horizon": { "$value": "#FAD3A8" } } },
    "mediodia": { "from": { "$value": 35 }, "accent": { "$type": "color", "$value": "#F7792C" }, "sky": { "top": { "$value": "#5C9FD8" }, "mid": { "$value": "#A8D3F0" }, "horizon": { "$value": "#FCEFD6" } } },
    "tarde": { "from": { "$value": 55 }, "accent": { "$type": "color", "$value": "#F2672E" }, "sky": { "top": { "$value": "#5B7FB0" }, "mid": { "$value": "#E8B98A" }, "horizon": { "$value": "#F7A15A" } } },
    "atardecer": { "from": { "$value": 75 }, "accent": { "$type": "color", "$value": "#EC553F" }, "sky": { "top": { "$value": "#2C3566" }, "mid": { "$value": "#C2607A" }, "horizon": { "$value": "#F7792C" } } },
    "anochecer": { "from": { "$value": 90 }, "accent": { "$type": "color", "$value": "#8C7BEA" }, "sky": { "top": { "$value": "#0A1B35" }, "mid": { "$value": "#2C2F5E" }, "horizon": { "$value": "#8A3F5A" } } }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Outfit", "ui-sans-serif", "system-ui", "sans-serif"], "$description": "Brand face (SIL OFL). Titles, UI, numbers." },
      "body": { "$value": ["Outfit", "ui-sans-serif", "system-ui", "sans-serif"] },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 }, "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "12px" }, "sm": { "$value": "14px" }, "md": { "$value": "16px" }, "lg": { "$value": "20px" },
      "xl": { "$value": "25px" }, "2xl": { "$value": "31px" }, "3xl": { "$value": "39px" }, "4xl": { "$value": "49px" }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.1 }, "snug": { "$value": 1.3 }, "normal": { "$value": 1.55 }
    },
    "tracking": {
      "$type": "dimension",
      "tight": { "$value": "-0.02em" }, "normal": { "$value": "0em" }, "label": { "$value": "0.08em" }
    }
  },
  "space": {
    "$type": "dimension",
    "0": { "$value": "0px" }, "1": { "$value": "2px" }, "2": { "$value": "4px" }, "3": { "$value": "8px" }, "4": { "$value": "12px" },
    "5": { "$value": "16px" }, "6": { "$value": "24px" }, "7": { "$value": "32px" }, "8": { "$value": "48px" }, "9": { "$value": "64px" }, "10": { "$value": "96px" }
  },
  "radius": {
    "$type": "dimension",
    "xs": { "$value": "4px" }, "sm": { "$value": "8px" }, "md": { "$value": "12px" }, "lg": { "$value": "18px" }, "xl": { "$value": "24px" },
    "emblem": { "$value": "18%", "$description": "The emblem's rounded square: 184 / 1024." },
    "full": { "$value": "999px" }
  },
  "shadow": {
    "$type": "shadow",
    "sm": { "$value": "0 1px 2px rgba(10, 27, 53, 0.10)" },
    "md": { "$value": "0 4px 14px rgba(10, 27, 53, 0.12)" },
    "lg": { "$value": "0 14px 40px rgba(10, 27, 53, 0.18)" },
    "glow": { "$value": "0 0 0 4px rgba(247, 121, 44, 0.28)", "$description": "Focus ring and the lantern's glow." }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" }, "base": { "$value": "200ms" }, "slow": { "$value": "320ms" },
      "step": { "$value": "800ms", "$description": "One stride of the explorer." },
      "breathe": { "$value": "4000ms", "$description": "Lantern glow while waiting." }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "walk": { "$value": [0.45, 0, 0.55, 1] }
    }
  }
}
